<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>StelarithControlPlugin</RootNamespace>
    <AssemblyName>StelarithControlPlugin</AssemblyName>
  </PropertyGroup>

  <!--
    对齐 ClassIsland 真实插件 SDK（公开 NuGet：ClassIsland.PluginSdk）。
    版本已绑定到本机验证通过的 PluginSdk 1.4.3.1（对应 ClassIsland 1.4.3.1）。
    若部署目标 ClassIsland 版本不同，按该版本 PluginSdk 调整下方 Version。

    部署步骤：
      1) dotnet build -c Release
      2) 把生成的 StelarithControlPlugin.dll（及依赖）放进：
         %APPDATA%\ClassIsland\Plugins\StelarithControlPlugin\
      3) 重启 ClassIsland；带 [PluginEntrance] 的程序集会被自动扫描加载。

    已知适配点（已编译验证）：
      · PluginBase.Initialize 为抽象方法 Initialize(HostBuilderContext, IServiceCollection)，无 base 实现；
      · 服务经构造函数注入 IServiceProvider 获取；INotificationHost 类型不存在（通知服务为
        INotificationHostService，仅提供 RegisterNotificationProvider，不暴露订阅事件），故指令接收
        不走通知订阅，改由本地代理 StelarithAgent 推流调用 OnStelarithTaskAsync。
  -->
  <ItemGroup>
    <PackageReference Include="ClassIsland.PluginSdk" Version="1.4.3.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>

</Project>
