# Stelarith CMS 环境变量
# 复制为 .env 并按需修改（.env 不提交 Git；.env.example 可提交）

# 管理后台默认密码（生产环境务必改为强密码！）
# 密码最终存于 content/users.json；此变量仅作兜底/初始种子。
# 注意：源码 src/lib/server/auth.ts 仍有默认种子值，部署时必须用此变量覆盖为强密码。
ADMIN_PASSWORD=__CHANGE_ME_TO_A_STRONG_PASSWORD__

# 站点公开地址（OG 标签 / sitemap / 绝对 URL）
PUBLIC_SITE_URL=https://www.245959623.xyz

# 生产环境：true 时 Cookie 标记 Secure（仅 HTTPS，务必开启）
COOKIE_SECURE=true

# ===== 环境标识与数据根（2026-09-26）=====
# 环境标识。**只**用于启动日志与 /api/v1/meta/build，不参与任何功能分支。
# 取值只允许 prod | dev | preview（见 docs/架构评估与落地路线.md 5.6：
# 环境是 prod|dev|preview，槽位是 a|b，版本号属构建 —— 三者不许互相冒充）。
# 生产由 run-prod.bat 显式 set；开发在 .env.dev 里设 dev。
# 不设也能跑，但启动日志会显示 "(STELARITH_ENV unset)" —— 宁可留空，也不猜。
STELARITH_ENV=prod

# 运行时数据根：content/ 与 uploads/ 都挂在它下面。
# 注释掉或删除本行 = 工程根，即 content/ 与 uploads/ 维持历史位置（既有部署零变更）。
# 开发环境在 .env.dev 里设 .dev-data，让两个目录一起搬走，与生产彻底隔离。
# STELARITH_DATA_ROOT=.dev-data

# Node 服务监听（adapter-node 读取）；与本机 run-prod.bat / 计划任务保持一致
PORT=8090
HOST=0.0.0.0

# 站点 Origin（生成绝对 URL，务必与反代域名一致）
ORIGIN=https://www.245959623.xyz

# ===== 集控面板（/admin/console）CIMS 代理配置 =====
# 集控面板内嵌于网站，对 CIMS 的调用统一经 /api/console/cims 服务端代理；
# 以下两项仅在服务端使用，绝不下发前端。
# CIMS management 端口基址（真实地址，如 http://127.0.0.1:8081 或内网域名）
CIMS_MANAGEMENT_URL=http://127.0.0.1:8081
# CIMS 服务账号令牌（拥有集控所需权限的账号；生产用专用服务账号，勿用个人账号）
CIMS_TOKEN=__CHANGE_ME_TO_CIMS_SERVICE_TOKEN__

# 集控代理（/api/console/cims）登录 CIMS 换取会话令牌用的服务账号。
# 必填：源码里刻意不留兜底值——写死过一次，直接随公开仓库泄漏了。
# 未配置时代理返回 502（cims auth unavailable）降级，不会回退到任何默认账号。
CIMS_ADMIN_EMAIL=__CHANGE_ME_CIMS_SERVICE_EMAIL__
CIMS_ADMIN_PASSWORD=__CHANGE_ME_CIMS_SERVICE_PASSWORD__

# CIMS 客户端应用（教室端配置拉取）端口基址。有默认值，一般不用配。
CIMS_CLIENT_URL=http://127.0.0.1:8096

# ── 邮件发送（2026-09-27 邮箱注册验证配套）──────────────────────────────
# 配置后注册/重发验证会自动发邮件到用户邮箱；未配置时前端直接回显验证链接
# （校园自部署无邮件环境时的兜底，注册页本就支持）。
# MAIL_HOST=__CHANGE_ME_SMTP_HOST__
# MAIL_PORT=25
# MAIL_USER=__CHANGE_ME__
# MAIL_PASS=__CHANGE_ME__
# MAIL_FROM=__CHANGE_ME__

# 集控租户基域。必须等于 CIMS-backend/.env 的 CIMS_BASE_DOMAIN。
# 面板代理读「教室端配置」（课表/组件）时会带 Host: <slug>.<本值>；不一致则那条路径 403，
# 而面板其它功能全正常 —— 症状极像「只有课表坏了」，很难查。缺省 localhost，别依赖缺省。
CIMS_BASE_DOMAIN=__CHANGE_ME_SAME_AS_CIMS_BACKEND__

# 集控面板**目标租户 slug**（可选，建议配置）。
# 决定面板读课表/组件时拼的 Host 头 <slug>.<CIMS_BASE_DOMAIN>。
# 不配时回退取"登录用户有权限账户列表"的 list[0].slug —— 那是无序列表，
# 多租户会让面板**永远读第一个账户的资源**（串租户，与当前设备/班级无关）。
# 显式指定后，面板恒读该租户（如 demo-class），彻底消除串租户。单租户一贯如此建议留空以兼容。
CONSOLE_TARGET_SLUG=__CHANGE_ME_TARGET_TENANT_SLUG__

# ===== 校园点歌（voicehub）联动配置 =====
# 站点公开页 /voicehub 经服务端拉取 voicehub 公开 API；以下仅在服务端使用，绝不下发前端。
# voicehub 公开 API 基址（含 https://）；需在 voicehub 后台生成具 songs:read 权限的 API Key。
VOICEHUB_BASE=https://voicehub.245959623.xyz
VOICEHUB_KEY=__CHANGE_ME_TO_VOICEHUB_API_KEY__

# ===== 集控审计哈希链（2026-09-17）=====
# console_audit 每行都带 prev_hash/row_hash，改一行、删一行、插一行都会让链对不上。
# 配了本密钥 → HMAC-SHA256：即使有人能直连 SQLite 改库，没有密钥也造不出自洽的链。
# 不配    → 裸 SHA256：只能防「随手改一行」。面板会**如实显示当前档位**，不会假装安全。
# ⚠️ 一旦配了就必须长期稳定 + 备份：换密钥 = 此前所有记录的链全部校验不过（旧行无法重算）。
#    生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONSOLE_AUDIT_KEY=__CHANGE_ME_64_HEX_CHARS__
# 审计保留天数。涉及未成年人的行为记录，「留多久」必须是明确数字而非默认无限。
# 裁剪只裁「连续前缀」并登记锚点，因此裁剪后剩余的链仍然可校验；裁剪动作本身也留痕。
CONSOLE_AUDIT_RETENTION_DAYS=180

# ── 设备会话回报密钥（2026-09-20 加）──
# 教室端本地代理无用户会话，靠这枚部署级共享密钥把 VNC/媒体直连的 ip:port:token
# 登记到扩展网关。教室机代理侧同名变量为 STELARITH_EXT_SECRET，两处必须一致。
# 留空 = 该入口拒绝一切上报（fail-closed），面板将永远显示"未收到会话回执"。
CONSOLE_DEVICE_REPORT_SECRET=
# 设备会话存活秒数（默认 300），过期自动失效，防止面板拿到死地址。
CONSOLE_SESSION_TTL_SECONDS=300

# ===== 项目展板 · GitHub 同步（2026-09-24）=====
# 项目展板靠 GitHub REST API 拉取仓库元数据、近一年提交活跃度与发行列表。
# 配了  → 5000 次/小时的认证配额，且能看到私有仓库（需勾 repo 读权限）。
# 不配  → 自动降级为**匿名**调用，仅 60 次/小时；展板功能仍可用，但同步几个仓库
#         就可能触发限流（后台会明确显示「GitHub 匿名」并给出重置时间）。
# 细粒度 PAT 建议只勾：Contents(read)、Metadata(read)、Releases(read)。
# 生成：https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# ===== OAuth 授权服务器（本站作为 IdP，2026-09-24）=====
# 本站能给其它客户端做「用 Stelarith 账号登录」：星集控桌面端、VoiceHub 校园广播。
# 客户端清单在 content/oauth-clients.json（**不含密钥**，可随仓库走、可人工 review）；
# 密钥只放在这里，清单里用 secretEnv 指向下面的变量名。改清单不用重启，改密钥要重启。
#
# ⚠️ OAUTH_DESKTOP_SECRET 一旦改动，已经发布出去的桌面端会立刻登不上（除非同步改
#    那边的常量），所以这里留空 = 沿用历史默认值，不要随手填一个新的。
OAUTH_DESKTOP_SECRET=
# VoiceHub 的 client_secret（32 位以上随机串）。填好后到 /admin/oauth 复制给 VoiceHub 后台。
OAUTH_VOICEHUB_SECRET=

# ===== 个人附件库 / 图床 · Cloudflare R2（2026-09-26）=====
# 头像、附件、图床的图片全部存这里。四个必填项缺一个，上传接口直接 503（不会偷偷落到别处）。
# 建桶：Cloudflare 控制台 → R2 → 创建存储桶 → 记录 Account ID 与桶名
# Token：R2 → 管理 API Tokens → 创建（Object Read & Write）
# 记得给桶打开「公开访问」，否则上传的图片外链打开是一片 403。
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 可选：给桶绑了自定义域名（https://cdn.example.com）就填它，附件外链会自动换成你的域名
R2_PUBLIC_URL=
# 可选：多个站点共用一个桶时的目录前缀，留空即桶根目录
R2_PREFIX=
# 可选：水印上的文字，默认 Stelarith
SITE_NAME=Stelarith

# ==========================================================================
# 备份（scripts/backup-db.mjs）
# 生成密钥：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠ BACKUP_KEY 丢失 == 所有数据库备份永久无法解密。请离线抄一份，
#   并且不要和 R2 / B2 的凭证存在同一个地方（一起丢或一起泄就都完了）。
BACKUP_KEY=
# 备份在对象存储里的根（脚本会自动拼 /sqlite/<时间戳>/，这里不要写 "sqlite"）
BACKUP_R2_PREFIX=backups
# 保留策略 GFS：最近 N 天全留 / 最近 N 个 ISO 周各留一份最新 / 最近 N 个月各留一份最新
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12

# ===== 份 3：Backblaze B2（真正的异地）=====
# 只有它够格叫"异地"：与 R2 不同的服务商、不同的账号、不同的密钥。
# 于是"机器没了 / 硬盘挂了 / 这台机器被入侵"三种情况它都能活下来。
# 四项缺一，备份脚本会以退出码 2 直接失败，不会假装成功。
# B2_ACCOUNT_ID=
# B2_BUCKET=
# B2_ACCESS_KEY_ID=
# B2_SECRET_ACCESS_KEY=
# B2_REGION=us-west-001
# B2_PREFIX=backups

# ══════════════════════════════════════════════════════════════════════════
# 星集控云端 WebSocket（手机集控 / 集控画面用，2026-10-02 D6 加）
# 浏览器直连云端 /ws/viewer（WS＋JPEG 截图定案路径，非 WebRTC）。
# ⚠️ 本机桌面调试用 127.0.0.1；手机或局域网访问必须改成云端可达地址
#    （如 ws://192.168.1.10:8788，或经站点反代后的同域 wss://<域名>/ws/viewer）。
# 云端 /ws/viewer 当前无令牌，仅"登录后才进本页"作为账号复用层；
#    公网暴露前务必先加令牌或反代鉴权（属 P1 安全加固，不阻塞 D6）。
# PUBLIC_CLOUD_WS_URL=ws://127.0.0.1:8788
