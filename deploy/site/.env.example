# ── PostgreSQL（compose 内的 postgres 服务）─────────────────────────────────
POSTGRES_USER=stelarith_app
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=stelarith

# ── 站点 ───────────────────────────────────────────────────────────────────
# 正式域名（配 TLS 证书 + nginx server_name）；CSRF/绝对 URL 推导用
ORIGIN=https://your-domain.example
# 首次初始化管理员口令（users 表为空时生效；留空则随机生成并只打一次日志）
ADMIN_PASSWORD=
# 构建版本标识（保证 client/server hydration 一致；留空退化到 package.json version）
BUILD_ID=
# 环境标识（写进启动日志，便于事后追账）
STELARITH_ENV=prod

# ── 备份（scripts/backup-cloud.mjs）────────────────────────────────────────
# 备份保留份数
BACKUP_KEEP=14
# 异地拷贝命令（可选）：对每个新生成的备份目录执行，$DIR 为占位。
# R2 就绪（绑卡后）示例：BACKUP_OFFSITE_CMD=rclone copy "$DIR" r2:my-bucket/stelarith/$(basename "$DIR")
# Openlist/WebDAV 示例：把 $DIR 用 curl/curl-webdav 推过去。缺省则仅本地保留。
BACKUP_OFFSITE_CMD=
