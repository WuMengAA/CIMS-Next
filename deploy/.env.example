# CIMS 校园集控 - 环境变量模板
# 复制为 .env 后填入真实值（不要提交真实 .env 到版本库）

# ---------- 数据库 (PostgreSQL 18) ----------
DB_USER=cims
DB_PASSWORD=CHANGE_ME_strong_password
DB_NAME=cims
DB_HOST=postgres
DB_PORT=5432

# ---------- Redis (7) ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- CIMS 三端口 ----------
# 生产建议：client 仅内网，management 经 nginx 反代，admin 仅运维网络
CIMS_CLIENT_PORT=8000
CIMS_MANAGEMENT_PORT=8001
CIMS_ADMIN_PORT=8002

# ---------- 对外域名 (客户端连接用) ----------
CIMS_PUBLIC_HOST=cims.example.edu
# 客户端 Manifest 基址，如 http://cims.example.edu:8000
CIMS_CLIENT_BASE_URL=http://cims.example.edu:8000

# ---------- 密钥 / 安全 ----------
# PGP 私钥用于握手挑战（OOBE 初始化时生成，留空则首次启动生成）
CIMS_PGP_PRIVATE_KEY=
CIMS_PGP_PASSPHRASE=
# 会话密钥 / JWT 密钥（务必随机长字符串）
CIMS_SECRET_KEY=CHANGE_ME_random_32plus_chars
CIMS_API_KEY_SALT=CHANGE_ME_random_salt

# ---------- 超管初始账户 (OOBE) ----------
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=CHANGE_ME_admin_password

# ---------- 运行环境 ----------
CIMS_ENV=production
LOG_LEVEL=INFO

# ---------- Stelarith 集控扩展网关（协作/上报/VNC回执，自有服务） ----------
# 面板「连接设置 → 扩展网关地址」填 http://<host>:${EXT_GATEWAY_PORT}
EXT_GATEWAY_PORT=8088
# 设备代理回报 VNC 会话用：STELARITH_EXT_URL=http://<host>:${EXT_GATEWAY_PORT}
# 远程控制令牌验签共享密钥（面板「指令密钥」须与此一致；生产建议改用网站 Ed25519 签名）
STELARITH_TASK_SECRET=CHANGE_ME_task_shared_secret
