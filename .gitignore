node_modules

# Output
.output
.vercel
.netlify
.wrangler
/.svelte-kit
/build

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.*
!.env.example
!.env.test

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# SQLite 运行库（多用户 / 会话 / 活动流；运行时生成，不入库）
/content/stelarith.db
/content/stelarith.db-wal
/content/stelarith.db-shm

# CMS data (sensitive / runtime-generated)
/content/users.json
/content/comments.json
/content/link-applications.json
/content/nav.json
/content/settings.json
/content/stats.json
/content/announcements.json
/content/feedback.json
/content/cache/
/uploads/*
!/uploads/.gitkeep

# 开发环境数据根：run-dev.bat 与 .env.dev 里的 STELARITH_DATA_ROOT=.dev-data
# 它同时承载 dev 的 content/ 与 uploads/（一个变量管两个目录），整目录皆运行时数据。
/.dev-data/

# 端到端排障截图与用户上传件（运行时数据，随调试/使用产生）
/content/captures/
/content/files/

# 备份产物：本机份（含数据库明文快照）与 staging，俱是运行时数据。
# 入库的话，仓库里会躺着若干份完整数据库副本 —— 连密钥带用户数据一起上 GitHub。
# 云上（R2/B2）的备份不受此限制，它们本来就不在这台机器上。
/content/backups/

# Keep content example structure (optional)
!/content/posts/*.md
!/content/docs/*.md
!/content/projects/*.md

# Build logs & temp scripts
/build-*.txt
/build-*.log
/build_*.log
/stelarith.out.log
/uicheck.log
# 本地运行/调试日志（dev / prod 运行时产生）
*.log
# 日志轮转出来的第二代（stelarith-crashguard.log.1 这类，不被 *.log 覆盖）
*.log.[0-9]
.rebuild-log.txt
.prod-run.log
/*.mjs
/*.tmp
/_tmp_*

# Local deploy artifacts (rebuilt on demand)
/deploy-stelarith/
/*.tar.gz
/*.zip
# Solution-pack (Rust / Python / Tauri / Node 参考实现)
dist/
target/
*.bundle
__pycache__/

# .NET / C# 构建产物（ext/*/ 下 ClassIsland 插件）
bin/
obj/
*.user
# 临时构建备份目录
build_prev_*/
# 原子发布（scripts/release-site.mjs）的旁路产物与历史版本
build.next/
build.old-*/
build.failed-*/
_swap-selftest/

# Tauri generated (build.rs embed output)
/admin-console/src-tauri/gen/

# 本地部署/启动脚本（含明文密码，不入库）
start-*.ps1
# 生产启动器：含机器专属绝对路径，且曾是明文凭据的载体（2026-09-14 从历史清除）
/run-prod.bat

# WorkBuddy 项目级工作记忆与自动化（含个人信息，不入库）
/.workbuddy/

# ── 2026-09-26 收尾补漏：调试/探测残留（既不入库也无价值）──
# 浏览器自动化与端到端排障产物（截图、CDP 脚本、临时 HTML）
/_probe/
# macOS 元数据式垃圾（._ 前缀跟随文件被复制时产生）
._*
# 单次探测脚本与临时产物
_probe_*.cjs
.tmp-*
# .bak 后缀的启动器副本（run-prod.bat.bak-1790423670，含机器绝对路径）
*.bak-*
# 根目录散落的数据库/Cookie 残留（路径被拼错产生的空壳）
/*.db
/.*_cookies.txt
